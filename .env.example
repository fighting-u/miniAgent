# 模型 API 密钥（变量名需与 config.yaml 中的 api_key_env 保持一致）
DASHSCOPE_API_KEY=your_api_key_here

# 如使用其他 OpenAI 兼容服务，可按需配置对应密钥变量
# OPENAI_API_KEY=your_openai_api_key_here

# QQ 机器人通道凭据（启用 qq 通道时填写，变量名需与 config.yaml 中一致）
QQ_APP_ID=your_qq_app_id
QQ_APP_SECRET=your_qq_app_secret

# 可选：跳过本地代理的域名列表，避免挂梯子请求国内的接口请求超时
# NO_PROXY="example.com, .aliyuncs.com"